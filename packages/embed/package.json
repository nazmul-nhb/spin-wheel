{
	"name": "@spin-wheel/embed",
	"version": "1.2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./global": "./dist/spin-wheel.global.js"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown && node build-global.mjs",
		"build:global": "node build-global.mjs",
		"watch": "tsdown --watch",
		"dev": "vite"
	},
	"dependencies": {
		"@spin-wheel/core": "workspace:*",
		"@spin-wheel/renderer": "workspace:*",
		"@spin-wheel/widget": "workspace:*"
	},
	"devDependencies": {
		"esbuild": "^0.28.1",
		"tsdown": "0.22.14",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	}
}
