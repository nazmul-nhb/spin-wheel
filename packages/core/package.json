{
    "name": "@spin-wheel/core",
    "version": "1.0.0",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "watch": "tsdown --watch",
        "test": "vitest run"
    },
    "devDependencies": {
        "tsdown": "0.22.14",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    }
}
