{
	"name": "@spin-wheel/renderer",
	"version": "1.2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"watch": "tsdown --watch"
	},
	"peerDependencies": {
		"@spin-wheel/core": "workspace:*"
	},
	"dependencies": {
		"@spin-wheel/core": "workspace:*"
	},
	"devDependencies": {
		"tsdown": "0.22.14",
		"typescript": "^6.0.3"
	}
}
